{
  "name": "site-ressources",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vitrine.mjs && node scripts/contenus.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node prerender.js",
    "build:client": "vite build",
    "preview": "vite preview",
    "vitrine": "node scripts/vitrine.mjs",
    "brevo:setup": "node scripts/brevo-setup.mjs",
    "brevo:test": "node scripts/brevo-test.mjs",
    "brevo:template": "node scripts/brevo-template.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrer.mjs",
    "db:seed-permissions": "node scripts/seed-permissions.mjs",
    "dev:backoffice": "node scripts/dev-backoffice.mjs",
    "contenus:exporter": "node scripts/contenus.mjs",
    "contenus:importer": "node --env-file=.env.local scripts/importer-contenu-existant.mjs",
    "db:migrate:prod": "node --env-file=.env.local scripts/migrer.mjs --production"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "octokit": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "vite": "^5.4.2"
  }
}
